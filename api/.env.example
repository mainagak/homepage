# Vercel(/api, FastAPI)用の環境変数サンプル。
# 実際の値はVercelダッシュボードのEnvironment Variables機能でProduction/Preview別に
# 設定すること(このファイルには絶対にダミー値以外を書かないこと)。
# MVP時点で必須の4変数のみ記載する(internal-spec-vercel.md 8章)。

# Google reCAPTCHA v2 シークレットキー(siteverify呼び出し用)
RECAPTCHA_SECRET_KEY=dummy-recaptcha-secret-key

# Cyberhome側 site/conf/hmac_secret.txt と一致させる共有シークレット
# (reCAPTCHA検証トークンのHMAC-SHA256署名に使用)
INTEGRATION_HMAC_SECRET=dummy-hmac-shared-secret

# CORSで許可するオリジン(Cyberhome本番サイト)
ALLOWED_ORIGIN=https://jyoho1.web.cyberhome.ne.jp

# 実行環境識別子(production / preview / development)
VERCEL_ENV=development
